# Copie para .env se quiser mudar algo. Todos têm padrão.
POSTGRES_USER=estudos
POSTGRES_PASSWORD=estudos
POSTGRES_DB=estudos

# Porta do app no seu Mac (http://localhost:5182)
APP_PORT=5182
# Porta do Postgres no seu Mac, para `npm run dev` e ferramentas de banco
DB_PORT=5434

# Fuso usado para gravar as datas. Precisa ser o seu.
TZ=America/Sao_Paulo

# Login (tranca do app). 1 exige senha, 0 desliga.
# No Docker o padrão já é 1; o app desktop entra sempre direto.
ESTUDOS_LOGIN=1
# Força o cookie de sessão como Secure. Normalmente não precisa: o cookie já
# vira Secure sozinho quando a requisição chega por HTTPS.
COOKIE_SEGURO=0

# ------------------------- hospedagem na web -------------------------
# Para rodar o app na nuvem, com os dados compartilhados entre dispositivos,
# veja DEPLOY.md. Lá o banco não é o container local: é um Postgres gerenciado,
# e basta definir DATABASE_URL e TZ no painel do host.
#
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
#
# Defina ESTUDOS_PROXY=0 apenas se o Node estiver exposto direto, sem proxy na
# frente — em host de nuvem, deixe de fora.
# ESTUDOS_PROXY=0

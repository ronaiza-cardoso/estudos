# Copie para .env se quiser mudar algo. Todos têm padrão.
POSTGRES_USER=estudos
POSTGRES_PASSWORD=estudos
POSTGRES_DB=estudos

# Porta do app no seu Mac (http://localhost:5182)
APP_PORT=5182
# Porta do Postgres no seu Mac, para `npm run dev` e ferramentas de banco
DB_PORT=5434

# Fuso usado para gravar as datas. Precisa ser o seu.
TZ=America/Sao_Paulo

# Login (tranca do app). 1 exige senha, 0 desliga.
# No Docker o padrão já é 1; o app desktop entra sempre direto.
ESTUDOS_LOGIN=1
# Marca o cookie de sessão como Secure. Só com HTTPS na frente.
COOKIE_SEGURO=0
